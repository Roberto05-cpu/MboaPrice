<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MboaPrice.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Green">#217A59</Color>
            <Color x:Key="DarkGreen">#174D3A</Color>
            <Color x:Key="PaleGreen">#E8F2E8</Color>
            <Color x:Key="Background">#F5F7F1</Color>
            <Color x:Key="TextDark">#183B30</Color>
            <Color x:Key="Muted">#718078</Color>
            <Style TargetType="ContentPage">
                <Setter Property="BackgroundColor" Value="{StaticResource Background}" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource Green}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16,13" />
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>
            <Style TargetType="Entry">
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="TextColor" Value="{StaticResource TextDark}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
